# ─────────────────────────────────────────────────────────────────────────────
# MarketPulse — environment variables template.
# Copy this file to `.env` and fill in your own values:   cp .env.example .env
# The real `.env` is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI engine (Google Gemini — CSS selector generation / self-healing) ───────
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# docker-compose creates the database with this password. Pick your own.
POSTGRES_PASSWORD=change-me-db-password
# For scripts run outside docker-compose; use the same password, host `localhost`.
DATABASE_URL=postgresql+asyncpg://market_user:change-me-db-password@localhost:5432/market_pulse_db

# ── Redis (job queue for the distributed scrape worker) ──────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Generate a real secret:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-secret
# This email is auto-promoted to admin on registration.
ADMIN_EMAIL=admin@example.com

# ── Distributed scrape worker ────────────────────────────────────────────────
# Shared secret between server and the local worker (scripts/scrape_worker.py).
# Any random string; must be identical on both sides.
WORKER_TOKEN=change-me-shared-worker-secret

# ── Telegram bot (price alerts) ──────────────────────────────────────────────
# Create a bot via @BotFather to get the token + username.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=YourBotUsername
TELEGRAM_WEBHOOK_SECRET=any-random-webhook-secret
# "true" = long-polling (no public HTTPS needed — good for local dev).
TELEGRAM_POLLING=true

# ── Email (Resend HTTP API — preferred) ──────────────────────────────────────
# Free signup at https://resend.com (100 emails/day). Verify a domain to send
# to arbitrary recipients; otherwise only your signup address works.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=MarketPulse <noreply@yourdomain.com>

# ── Email (SMTP — legacy fallback, local dev only) ───────────────────────────
# Most clouds (incl. DigitalOcean) block outbound port 587, so SMTP rarely works
# in production — use Resend above. Leave blank if using Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Public URLs ──────────────────────────────────────────────────────────────
# Frontend → API base. Local dev: http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api
# Used in email links ("View on MarketPulse"). Local dev: http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

# ── Proxies (optional — scraping rotation; leave empty for direct) ───────────
PROXY_LIST=
